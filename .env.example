# OpenVPN Dashboard - Environment Configuration
#
# Copy this file to .env and configure your settings:
#   cp .env.example .env
#
# Required settings are marked with (REQUIRED)
# Optional settings have default values shown
#
# =============================================================================
# DEPLOYMENT MODES
# =============================================================================
#
# Mode A — one-click OpenVPN + UI (full stack)
#   Data dir:  OPENVPN_DATA_DIR=./stack-data/openvpn
#   UI port:   WEB_PORT=8800
#   Start:     ./install.sh
#              docker compose --profile vpn up -d
#   Starts the OpenVPN container (Easy-RSA generate-config.sh on an empty data
#   dir — do not run angristan at container start) plus web, collector, scheduler.
#
# Mode B — UI-only attach to an already-running host OpenVPN
#   OPENVPN_DATA_DIR=/etc/openvpn
#   OPENVPN_STATUS_LOG=/etc/openvpn/status.log
#   Start:     ./install.sh --ui-only
#              docker compose up -d   # no --profile vpn
#   Host must already have Easy-RSA PKI, server.conf, writable ccd/, and
#   status.log on the mounted tree. Do NOT run angristan at container start
#   (the openvpn service is not started).
#   status.log must live on the mounted tree, not host /var/log/openvpn
#   unless that path is also mounted.

# =============================================================================
# Docker Image SETTINGS
# =============================================================================

IMAGE_NAME=my-custom-openvpn-dashboard
IMAGE_TAG=v1.0.0

# =============================================================================
# DJANGO SETTINGS
# =============================================================================

DJANGO_SETTINGS_MODULE=config.settings

# (REQUIRED) Django secret key - generate a secure random string
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-secret-key-here-change-this

# Debug mode - set to False in production
DEBUG=False

# Allowed hosts - comma-separated list of hostnames
# Use * for development, specific hostnames for production
ALLOWED_HOSTS=*

# Time zone for the application
TIME_ZONE=UTC

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# ADMIN USER SETTINGS
# =============================================================================

# Admin username for login (default: admin)
ADMIN_USERNAME=admin

# (REQUIRED) Admin password - set a strong password
ADMIN_PASSWORD=your-secure-password-here

# Admin email address (optional)
ADMIN_EMAIL=admin@localhost

# =============================================================================
# WEB SERVER SETTINGS
# =============================================================================

# Port to expose the web UI (Mode A default: 8800)
WEB_PORT=8800

# CSRF trusted origins - comma-separated list of origins
# Required if behind a reverse proxy with HTTPS
# Example: https://vpn.example.com,https://admin.example.com
CSRF_TRUSTED_ORIGINS=

# =============================================================================
# CLIENT CONFIG STORAGE
# =============================================================================

# Local path to store generated .ovpn client configuration files
# This is a host path (not a Docker volume) for easy access to distribute configs
# Examples: ./ovpn-configs, /root/ovpn-configs, /home/user/vpn-clients
CLIENT_CONFIGS_PATH=./ovpn-configs

# Host path to store the SQLite database for true persistence
# Data survives even if Docker volumes are deleted
# Examples: ./stack-data/ui, /opt/openvpn-dashboard/data, /var/lib/openvpn-dashboard
DATABASE_HOST_PATH=./stack-data/ui

# =============================================================================
# OPENVPN DOCKER SERVER
# =============================================================================
# Shared host tree mounted at /etc/openvpn in every container.
#
# Mode A (one-click stack): leave as ./stack-data/openvpn
# Mode B (UI-only attach):  OPENVPN_DATA_DIR=/etc/openvpn
#   ./install.sh --ui-only requires this to be set.
#   Host needs Easy-RSA PKI, server.conf, writable ccd/, status.log.
#   Do not run angristan at container start.
OPENVPN_DATA_DIR=./stack-data/openvpn
OPENVPN_ENDPOINT=
OPENVPN_PORT=1194
OPENVPN_PROTO=udp
OPENVPN_SUBNET=10.8.0.0/24
OPENVPN_STATUS_INTERVAL=10
OPENVPN_CONTAINER_NAME=openvpn

# =============================================================================
# OPENVPN SETTINGS (REQUIRED)
# =============================================================================

# (REQUIRED) Public address written into client .ovpn files
OPENVPN_SERVER_ADDRESS=vpn.example.com

# Must match OPENVPN_PORT when the VPN runs in this compose stack
OPENVPN_SERVER_PORT=1194

# OpenVPN protocol: udp or tcp (default: udp)
OPENVPN_PROTOCOL=udp

# End-entity certificate lifetime in days (server + client certs).
# Easy-RSA's built-in default is 825 (~2 years). Applies to new certs and
# renewals; existing certs keep their original expiry until renewed.
# Examples: 365 (1 year), 825 (~2 years), 3650 (10 years)
OPENVPN_CERT_EXPIRE=825

# =============================================================================
# OPENVPN PATHS (Usually don't need to change)
# =============================================================================

# Paths inside the container. The host tree is OPENVPN_DATA_DIR mounted at /etc/openvpn.
# status.log MUST be on that mounted tree (not host /var/log/openvpn unless also mounted).

# Main OpenVPN directory
OPENVPN_DIR=/etc/openvpn

# EasyRSA directory for certificate management
OPENVPN_EASY_RSA_DIR=/etc/openvpn/easy-rsa

# Client Config Directory (CCD) for per-client settings
OPENVPN_CCD_DIR=/etc/openvpn/ccd

# OpenVPN log directory (on the mounted data tree)
OPENVPN_LOG_DIR=/etc/openvpn

# Status log — must be on the mounted tree so collector/web can read it
# Mode A/B: /etc/openvpn/status.log  (NOT /var/log/openvpn/status.log unless that path is mounted)
OPENVPN_STATUS_LOG=/etc/openvpn/status.log

# =============================================================================
# USAGE COLLECTOR SETTINGS
# =============================================================================

# How often to poll the status log (in seconds)
# Lower values = more accurate tracking but more disk I/O
USAGE_COLLECTOR_INTERVAL=2.0

# How often to commit live usage to account totals (in seconds)
# Lower values = more frequent UI updates but more database writes
USAGE_COMMIT_INTERVAL=10.0

# =============================================================================
# SECURITY SETTINGS (Production)
# =============================================================================

# Enable secure cookies (set to True when using HTTPS)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# HSTS settings (only enable if you're sure about HTTPS configuration)
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Server URL for client configuration distribution
# This URL can be edited in the UI from the Account List page
# Example: https://your-vpn-server.com, http://192.168.1.100:8800
SERVER_URL=
